# Copy to .env, then replace every change-me value before preflight.
# Non-secret deployment settings only. The bearer secret is file-backed.
# Generate a distinct deployment ID per checkout/host; copied placeholders are rejected.
COMPOSE_PROJECT_NAME=change-me-project
ARVYX_DEPLOYMENT_ID=change-me-id
ARVYX_DATA_VOLUME=change-me-project_change-me-id_arvyx-data
ARVYX_CONTROL_SECRET_FILE=./secrets/arvyx-control-secret
# Shared only by deployments authorized to restore/fail over the same data.
ARVYX_BACKUP_AUTHORITY_ID=change-me-authority
ARVYX_BACKUP_BINDING_KEY_FILE=./secrets/arvyx-backup-binding-key
ARVYX_PORT=8765
ARVYX_DOMAIN=memory.example.com
ARVYX_IMAGE=arvyx:local
ARVYX_MEMORY_LIMIT=512m
ARVYX_CPU_LIMIT=1.0
